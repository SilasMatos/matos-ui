{
	"name": "@matos-ui/mcp",
	"version": "0.1.0",
	"description": "Read-only MCP server exposing the Matos UI registry and design-system knowledge (Surface Philosophy, Motion Tokens) to AI coding agents.",
	"keywords": [
		"mcp",
		"modelcontextprotocol",
		"matos-ui",
		"shadcn",
		"design-system",
		"registry",
		"ai",
		"claude"
	],
	"license": "MIT",
	"author": "Silas Matos",
	"homepage": "https://matos-ui.com/docs/mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SilasMatos/matos-ui.git",
		"directory": "packages/mcp"
	},
	"type": "module",
	"bin": {
		"matos-ui-mcp": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup && chmod +x dist/index.js",
		"prepublishOnly": "bun run build",
		"dev": "tsup --watch",
		"check-types": "tsc --noEmit",
		"inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@matos-ui/config": "workspace:*",
		"@types/node": "^22",
		"tsup": "^8.5.1",
		"typescript": "^5"
	},
	"engines": {
		"node": ">=18"
	}
}
