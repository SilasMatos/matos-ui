  "files": [
    {
      "path": "components/examples/switch-demo.tsx",
      "content": "\"use client\";\r\n\r\nimport { useState } from \"react\";\r\nimport { Switch } from \"@/components/ui/switch\";\r\n\r\nexport default function SwitchDemo() {\r\n  const [a, setA] = useState(true);\r\n  const [b, setB] = useState(false);\r\n\r\n  return (\r\n    <div className=\"flex flex-col gap-10\">\r\n      <section className=\"flex flex-col gap-3\">\r\n        <p className=\"text-xs font-medium uppercase tracking-wider text-muted-foreground\">\r\n          Tamanhos · filled · pill\r\n        </p>\r\n        <div className=\"flex flex-wrap items-center gap-6\">\r\n          <Switch size=\"sm\" checked={a} onCheckedChange={setA} aria-label=\"Pequeno\" />\r\n          <Switch size=\"md\" checked={b} onCheckedChange={setB} aria-label=\"Médio\" />\r\n          <Switch size=\"lg\" defaultChecked aria-label=\"Grande\" />\r\n        </div>\r\n      </section>\r\n\r\n      <section className=\"flex flex-col gap-3\">\r\n        <p className=\"text-xs font-medium uppercase tracking-wider text-muted-foreground\">\r\n          Variante outline\r\n        </p>\r\n        <div className=\"flex flex-wrap items-center gap-6\">\r\n          <Switch variant=\"outline\" defaultChecked aria-label=\"Outline ligado\" />\r\n          <Switch variant=\"outline\" aria-label=\"Outline desligado\" />\r\n        </div>\r\n      </section>\r\n\r\n      <section className=\"flex flex-col gap-3\">\r\n        <p className=\"text-xs font-medium uppercase tracking-wider text-muted-foreground\">\r\n          Forma retangular\r\n        </p>\r\n        <div className=\"flex flex-wrap items-center gap-6\">\r\n          <Switch shape=\"rectangle\" defaultChecked aria-label=\"Retangular\" />\r\n          <Switch\r\n            shape=\"rectangle\"\r\n            variant=\"outline\"\r\n            aria-label=\"Retangular outline\"\r\n          />\r\n        </div>\r\n      </section>\r\n\r\n      <section className=\"flex flex-col gap-3\">\r\n        <p className=\"text-xs font-medium uppercase tracking-wider text-muted-foreground\">\r\n          Com ícone · com rótulo On/Off\r\n        </p>\r\n        <div className=\"flex flex-wrap items-center gap-6\">\r\n          <Switch content=\"icon\" defaultChecked aria-label=\"Com ícone\" />\r\n          <Switch content=\"icon\" variant=\"outline\" aria-label=\"Ícone outline\" />\r\n          <Switch content=\"label\" aria-label=\"Com texto\" />\r\n          <Switch content=\"label\" size=\"lg\" defaultChecked aria-label=\"Texto grande\" />\r\n        </div>\r\n      </section>\r\n    </div>\r\n  );\r\n}\r\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}