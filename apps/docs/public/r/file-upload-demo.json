      "path": "components/matos-ui/examples/file-upload-demo.tsx",
      "content": "\"use client\";\n\nimport { useState } from \"react\";\nimport type { FileUploadFile } from \"@/components/matos-ui/file-upload\";\nimport { FileUpload } from \"@/components/matos-ui/file-upload\";\n\nexport default function FileUploadDemo() {\n  const [singleFiles, setSingleFiles] = useState<FileUploadFile[]>([]);\n  const [multiFiles, setMultiFiles] = useState<FileUploadFile[]>([]);\n\n  return (\n    <div className=\"mx-auto flex w-full max-w-2xl flex-col gap-8\">\n      <section className=\"flex flex-col gap-3\">\n        <div className=\"space-y-1\">\n          <p className=\"text-xs font-medium uppercase tracking-widest text-muted-foreground\">\n            Single file\n          </p>\n          <h3 className=\"text-sm font-medium\">Quiet upload surface</h3>\n        </div>\n        <FileUpload\n          files={singleFiles}\n          onFilesChange={setSingleFiles}\n          accept=\"image/*,.pdf\"\n          maxSize={5 * 1024 * 1024}\n          title=\"Drop your file\"\n          description=\"Images or PDF up to 5 MB\"\n        />\n      </section>\n\n      <section className=\"flex flex-col gap-3\">\n        <div className=\"space-y-1\">\n          <p className=\"text-xs font-medium uppercase tracking-widest text-muted-foreground\">\n            Multiple files\n          </p>\n          <h3 className=\"text-sm font-medium\">Stacked file feedback</h3>\n        </div>\n        <FileUpload\n          variant=\"outline\"\n          multiple\n          maxFiles={5}\n          files={multiFiles}\n          onFilesChange={setMultiFiles}\n          title=\"Drop up to 5 files\"\n          description=\"The list animates as files are added or removed\"\n        />\n      </section>\n\n      <section className=\"grid grid-cols-1 gap-3 md:grid-cols-3\">\n        <FileUpload size=\"sm\" title=\"Default\" description=\"Minimal\" />\n        <FileUpload\n          variant=\"outline\"\n          size=\"sm\"\n          title=\"Outline\"\n          description=\"Subtle border\"\n        />\n        <FileUpload\n          variant=\"ghost\"\n          size=\"sm\"\n          title=\"Ghost\"\n          description=\"Soft surface\"\n        />\n      </section>\n    </div>\n  );\n}\n",
      "type": "registry:example",
      "target": "components/matos-ui/examples/file-upload-demo.tsx"
    }
  ],
  "type": "registry:example"
}