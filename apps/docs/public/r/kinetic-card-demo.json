{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kinetic-card-demo",
  "registryDependencies": [
    "kinetic-card"
  ],
  "files": [
    {
      "path": "components/matos-ui/examples/kinetic-card-demo.tsx",
      "content": "\"use client\";\n\nimport {\n  KineticCard,\n  KineticCardContent,\n  KineticCardFooter,\n  KineticCardHeader,\n} from \"@/components/matos-ui/kinetic-card\";\n\nconst signals = [\n  { label: \"Latency\", value: \"24ms\" },\n  { label: \"Sync\", value: \"98%\" },\n];\n\nexport default function KineticCardDemo() {\n  return (\n    <div className=\"flex w-full items-center justify-center\">\n      <KineticCard className=\"max-w-[360px]\" badge=\"Live\" tone=\"primary\">\n        <KineticCardHeader>\n          <div className=\"space-y-1 pr-16\">\n            <p className=\"text-xs font-medium uppercase tracking-widest text-muted-foreground\">\n              Signal\n            </p>\n            <h3 className=\"text-base font-semibold leading-5\">\n              Adaptive queue\n            </h3>\n          </div>\n        </KineticCardHeader>\n\n        <KineticCardContent>\n          <p className=\"text-muted-foreground text-xs leading-5\">\n            Compact motion surface for live SaaS state without turning into a\n            feature block.\n          </p>\n\n          <div className=\"mt-3 grid grid-cols-2 gap-2\">\n            {signals.map((signal) => (\n              <div\n                className=\"rounded-lg border border-border/70 bg-secondary px-2.5 py-2\"\n                key={signal.label}\n              >\n                <p className=\"text-[10px] font-medium text-muted-foreground\">\n                  {signal.label}\n                </p>\n                <p className=\"mt-0.5 text-sm font-semibold\">{signal.value}</p>\n              </div>\n            ))}\n          </div>\n        </KineticCardContent>\n\n        <KineticCardFooter>\n          <span className=\"text-xs text-muted-foreground\">\n            Updated just now\n          </span>\n          <span className=\"size-2 rounded-full bg-primary\" />\n        </KineticCardFooter>\n      </KineticCard>\n    </div>\n  );\n}\n",
      "type": "registry:example",
      "target": "components/matos-ui/examples/kinetic-card-demo.tsx"
    }
  ],
  "type": "registry:example"
}