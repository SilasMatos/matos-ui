{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-demo",
  "registryDependencies": [
    "context-menu",
    "elevated"
  ],
  "files": [
    {
      "path": "components/matos-ui/examples/context-menu-demo.tsx",
      "content": "\"use client\";\n\nimport { Copy, FolderInput, Pencil, Share2, Star, Trash2 } from \"lucide-react\";\nimport { useState } from \"react\";\nimport {\n  ContextMenu,\n  ContextMenuCheckboxItem,\n  ContextMenuContent,\n  ContextMenuItem,\n  ContextMenuLabel,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n} from \"@/components/matos-ui/context-menu\";\nimport { Elevated } from \"@/components/matos-ui/elevated\";\n\nexport default function ContextMenuDemo() {\n  const [starred, setStarred] = useState(true);\n  const [lastAction, setLastAction] = useState<string | null>(null);\n\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-3\">\n      <ContextMenu>\n        <ContextMenuTrigger className=\"outline-none\">\n          <Elevated\n            offset={1}\n            className=\"flex h-40 select-none items-center justify-center rounded-xl px-6 text-center text-sm text-muted-foreground\"\n          >\n            Right-click anywhere in this area\n            <br />\n            (long-press on touch)\n          </Elevated>\n        </ContextMenuTrigger>\n\n        <ContextMenuContent>\n          <ContextMenuLabel>Q3 revenue report</ContextMenuLabel>\n\n          <ContextMenuItem onSelect={() => setLastAction(\"Renamed\")}>\n            <Pencil />\n            Rename\n            <ContextMenuShortcut>F2</ContextMenuShortcut>\n          </ContextMenuItem>\n\n          <ContextMenuItem onSelect={() => setLastAction(\"Duplicated\")}>\n            <Copy />\n            Duplicate\n            <ContextMenuShortcut>⌘D</ContextMenuShortcut>\n          </ContextMenuItem>\n\n          <ContextMenuCheckboxItem\n            checked={starred}\n            onCheckedChange={setStarred}\n          >\n            <Star />\n            Starred\n          </ContextMenuCheckboxItem>\n\n          <ContextMenuSeparator />\n\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>\n              <FolderInput />\n              Move to\n            </ContextMenuSubTrigger>\n            <ContextMenuSubContent>\n              <ContextMenuItem\n                onSelect={() => setLastAction(\"Moved to Drafts\")}\n              >\n                Drafts\n              </ContextMenuItem>\n              <ContextMenuItem\n                onSelect={() => setLastAction(\"Moved to Archive\")}\n              >\n                Archive\n              </ContextMenuItem>\n              <ContextMenuItem\n                onSelect={() => setLastAction(\"Moved to Shared\")}\n              >\n                Shared with team\n              </ContextMenuItem>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n\n          <ContextMenuItem onSelect={() => setLastAction(\"Share link copied\")}>\n            <Share2 />\n            Share\n          </ContextMenuItem>\n\n          <ContextMenuSeparator />\n\n          <ContextMenuItem\n            variant=\"danger\"\n            onSelect={() => setLastAction(\"Deleted\")}\n          >\n            <Trash2 />\n            Delete\n            <ContextMenuShortcut>⌫</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuContent>\n      </ContextMenu>\n\n      <p className=\"text-xs text-muted-foreground\">\n        {lastAction ? `Last action: ${lastAction}` : \"No action yet.\"}\n      </p>\n    </div>\n  );\n}\n",
      "type": "registry:example",
      "target": "components/matos-ui/examples/context-menu-demo.tsx"
    }
  ],
  "type": "registry:example"
}